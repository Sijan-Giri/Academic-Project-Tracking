//   RETURN NEW;
// END;
// $$ LANGUAGE plpgsql;
// CREATE TRIGGER evaluation_lock_check BEFORE UPDATE ON evaluations FOR EACH ROW EXECUTE FUNCTION check_evaluation_locked();

model Evaluation {
  id            String   @id @default(uuid())
  projectId     String
  reviewStageId String
  evaluatorId   String
  totalMarks    Decimal?
  grade         String?
  feedback      String?
  isLocked      Boolean  @default(false)
  lockedAt      DateTime?
  lockedById    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project     Project           @relation(fields: [projectId], references: [id])
  reviewStage ReviewStage       @relation(fields: [reviewStageId], references: [id])
  evaluator   FacultyProfile    @relation(fields: [evaluatorId], references: [id])
  lockedBy    User?             @relation("LockedBy", fields: [lockedById], references: [id])
  scores      EvaluationScore[]

  @@unique([projectId, reviewStageId, evaluatorId])
  @@map("evaluations")
}

model EvaluationScore {
  id           String  @id @default(uuid())
  evaluationId String
  criteriaId   String
  marks        Decimal
  remarks      String?

  evaluation Evaluation         @relation(fields: [evaluationId], references: [id])
  criteria   EvaluationCriteria @relation(fields: [criteriaId], references: [id])

  @@unique([evaluationId, criteriaId])
}

model Milestone {
  id                String          @id @default(uuid())
  projectId         String
  reviewStageId     String?
  name              String
  description       String?
  deadline          DateTime
  status            MilestoneStatus @default(NOT_STARTED)
  requiredDocuments String[]
  order             Int
  updatedAt         DateTime        @updatedAt

  project     Project      @relation(fields: [projectId], references: [id])
  submissions Submission[]
}

model Submission {
  id            String   @id @default(uuid())
  milestoneId   String
  submittedById String
  submittedAt   DateTime @default(now())
  notes         String?
  version       Int      @default(1)

  milestone   Milestone @relation(fields: [milestoneId], references: [id])
  submittedBy User      @relation(fields: [submittedById], references: [id])
  files       File[]
}

model File {
  id           String   @id @default(uuid())
  submissionId String?
  projectId    String?
  originalName String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  uploadedAt   DateTime @default(now())

  submission Submission? @relation(fields: [submissionId], references: [id])
  project    Project?    @relation(fields: [projectId], references: [id])
  uploadedBy User        @relation(fields: [uploadedById], references: [id])
}

model Notification {
  id               String           @id @default(uuid())
  userId           String
  title            String
  message          String
  type             NotificationType
  isRead           Boolean          @default(false)
  relatedProjectId String?
  createdAt        DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}
